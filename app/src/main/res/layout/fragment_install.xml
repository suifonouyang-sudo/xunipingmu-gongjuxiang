<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/bg"
    android:orientation="vertical"
    android:padding="14dp">

    <!-- 扫描范围 -->
    <LinearLayout style="@style/Card">
        <TextView
            style="@style/CardLabel"
            android:text="扫描范围（可填多个目录，空格分隔）" />
        <EditText
            android:id="@+id/etApkDirs"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:inputType="text"
            android:minHeight="44dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:text="/sdcard /data/local/tmp"
            android:textColor="@color/text_main"
            android:textSize="13sp" />
        <TextView
            android:id="@+id/tvApkStat"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:fontFamily="monospace"
            android:text="尚未扫描"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/btnApkScan"
                style="@style/BtnPrimary"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="扫描安装包" />
            <TextView
                android:id="@+id/btnApkAllVol"
                style="@style/BtnOutline"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="全盘扫描" />
        </LinearLayout>
        <TextView
            android:id="@+id/btnApkDefault"
            style="@style/BtnOutline"
            android:layout_marginTop="8dp"
            android:text="恢复默认目录（内部存储 + adb 落地区）" />
        <TextView
            style="@style/CardHint"
            android:text="扫描、解析、安装全部以 shell(uid 2000) 身份执行，不受应用自身存储权限限制。[全盘扫描] 会自动枚举设备上的全部存储卷 —— 内部存储、内存卡、U 盘（/storage 下的各卷）以及 /data/local/tmp，一个不漏。" />
    </LinearLayout>

    <!-- 安装包列表：撑满中间剩余空间 -->
    <LinearLayout
        style="@style/Card"
        android:layout_height="0dp"
        android:layout_weight="1">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">
            <TextView
                style="@style/CardLabel"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:layout_marginBottom="0dp"
                android:text="安装包列表" />
            <TextView
                android:id="@+id/btnApkOnlyNew"
                style="@style/BtnMini"
                android:background="@drawable/bg_seg"
                android:text="仅未安装"
                android:textColor="@drawable/seg_text_color" />
        </LinearLayout>
        <EditText
            android:id="@+id/etApkFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:background="@drawable/bg_input"
            android:hint="按应用名 / 包名 / 文件名过滤"
            android:inputType="text"
            android:minHeight="42dp"
            android:paddingStart="10dp"
            android:paddingEnd="10dp"
            android:textColor="@color/text_main"
            android:textColorHint="@color/text_sub"
            android:textSize="13sp" />
        <ListView
            android:id="@+id/lvApks"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="8dp"
            android:layout_weight="1"
            android:divider="@null"
            android:dividerHeight="0dp" />
    </LinearLayout>

    <!-- 操作结果 -->
    <LinearLayout style="@style/Card">
        <TextView
            style="@style/CardLabel"
            android:text="操作结果" />
        <TextView
            android:id="@+id/tvApkResult"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_input"
            android:fontFamily="monospace"
            android:minHeight="46dp"
            android:padding="10dp"
            android:text="—"
            android:textColor="@color/text_main"
            android:textSize="12sp" />
    </LinearLayout>

</LinearLayout>
